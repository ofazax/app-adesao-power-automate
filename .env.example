# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# POWER_AUTOMATE_WEBHOOK_URL: Webhook HTTP URL generated# Webhook do Power Automate
# Cole aqui a URL do seu fluxo do Power Automate que insere os dados no SharePoint/Lists
POWER_AUTOMATE_WEBHOOK_URL="https://defaultc1880ac0d27949d8af71b4b7b31bf6.19.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/23/workflows/03cf05e084d9442a8050f436b57b1d01/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=KFr7SiVo0LqDfUlUKrSSsl4HoABe7df-JMuX9Vi3p5c"
